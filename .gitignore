# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# vitest reporter artifacts (generated; never commit)
.vitest/

# local npm cache (the user-level cache can be root-owned; see check-schema-drift)
.npm-cache/

# playwright browsers + artefacts (hundreds of MB; never commit)
.playwright-browsers/
test-results/
playwright-report/
