{
  "name": "dating-platform",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "PLAYWRIGHT_BROWSERS_PATH=\"$PWD/.playwright-browsers\" playwright test",
    "test:e2e:install": "PLAYWRIGHT_BROWSERS_PATH=\"$PWD/.playwright-browsers\" playwright install chromium",
    "audit": "npm audit --omit=dev --audit-level=high",
    "build:apply-all": "./scripts/build-apply-all.sh",
    "generate:icons": "node scripts/generate-icons.mjs",
    "generate:locales": "node scripts/generate-locales.mjs",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run audit && npm run build"
  },
  "dependencies": {
    "@stripe/stripe-js": "^10.1.0",
    "@supabase/auth-helpers-nextjs": "^0.15.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "framer-motion": "^14.6.0",
    "next": "^16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "stripe": "^23.0.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.4"
  }
}
