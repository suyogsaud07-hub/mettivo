# =============================================================================
# Mettivo — environment template
# =============================================================================
# Copy to `.env.local` for local development:
#
#     cp .env.local.example .env.local
#
# On Vercel, set BOTH variables in
#   Project -> Settings -> Environment Variables
# for Production, Preview and Development.
#
# -----------------------------------------------------------------------------
# BOTH VALUES ARE PUBLIC BY DESIGN.
# -----------------------------------------------------------------------------
# Mettivo has no application server: the browser talks straight to Supabase, so
# it must hold the project URL and the anon key. They are shipped to every
# visitor and are not secrets.
#
# The `service_role` key MUST NEVER appear here, in Vercel, in a commit, or in a
# prompt. It bypasses Row Level Security, which is the entire authorisation
# model (docs/CONSTITUTION.md Article 1.5). Administrative work is done in the
# Supabase SQL Editor, where the key is never handled by this repository.
#
# Find both values in:
#   Supabase dashboard -> Project Settings -> API
# -----------------------------------------------------------------------------

# Project URL, e.g. https://abcdefghijklmno.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# The `anon` / `public` key. Long-lived, public, and safe in a browser bundle
# ONLY because every table is protected by RLS. Verify that with:
#   ./scripts/verify-rls.sh
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# -----------------------------------------------------------------------------
# Optional
# -----------------------------------------------------------------------------
# Register the service worker during `next dev`, so PWA installability can be
# exercised locally and in the end-to-end suite. A caching worker serves stale
# chunks over HMR, which is why this is off in development by default.
# NEXT_PUBLIC_ENABLE_SW=true
