# =============================================================================
# Mettivo — environment template
# =============================================================================
# Copy to `.env.local` for local development:
#
#     cp .env.local.example .env.local
#
# On Vercel, set BOTH variables in
#   Project -> Settings -> Environment Variables
# for Production, Preview and Development.
#
# -----------------------------------------------------------------------------
# BOTH VALUES ARE PUBLIC BY DESIGN.
# -----------------------------------------------------------------------------
# Mettivo has no application server: the browser talks straight to Supabase, so
# it must hold the project URL and the anon key. They are shipped to every
# visitor and are not secrets.
#
# The `service_role` key MUST NEVER appear here, in Vercel, in a commit, or in a
# prompt. It bypasses Row Level Security, which is the entire authorisation
# model (docs/CONSTITUTION.md Article 1.5). Administrative work is done in the
# Supabase SQL Editor, where the key is never handled by this repository.
#
# Find both values in:
#   Supabase dashboard -> Project Settings -> API
# -----------------------------------------------------------------------------

# Project URL, e.g. https://abcdefghijklmno.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# The `anon` / `public` key. Long-lived, public, and safe in a browser bundle
# ONLY because every table is protected by RLS. Verify that with:
#   ./scripts/verify-rls.sh
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# -----------------------------------------------------------------------------
# Optional
# -----------------------------------------------------------------------------
# Register the service worker during `next dev`, so PWA installability can be
# exercised locally and in the end-to-end suite. A caching worker serves stale
# chunks over HMR, which is why this is off in development by default.
# NEXT_PUBLIC_ENABLE_SW=true

# -----------------------------------------------------------------------------
# Chat translation (optional) — SERVER-SIDE ONLY
# -----------------------------------------------------------------------------
# These are deliberately NOT prefixed with NEXT_PUBLIC_: only NEXT_PUBLIC_ values
# may reach the browser (docs/CONSTITUTION.md Article 1.5). They are read by the
# `/api/translate` route handler, which is the only thing that talks to the
# provider. A NEXT_PUBLIC_ translation key would be visible to every visitor and
# spendable by anyone.
#
# PRIMARY: DeepL API Free — https://www.deepl.com/pro-api
# Free tier is 500,000 characters/month, which is roughly 5,000 chat messages.
# Sign up, then copy the key from Account -> Authentication Key for API.
#
#   DEEPL_API_KEY=your-deepl-api-key
#
# Leave it UNSET and the feature still works: the route falls back to MyMemory,
# a no-key public service. That fallback is limited to ~5,000 characters/day
# anonymously, so it is a working default rather than a production quota.
#
# OPTIONAL: supplying a contact email raises MyMemory's anonymous daily limit
# from 5,000 to 50,000 characters. Nothing else is sent to them.
#
#   MYMEMORY_CONTACT_EMAIL=you@example.com

# -----------------------------------------------------------------------------
# Moderation AI (server-side only) — OpenAI-compatible provider
# -----------------------------------------------------------------------------
# Content moderation uses this private key, read server-side by
# src/lib/moderation/ai.ts (via the injected-source pattern).
#
# NEVER prefix this with NEXT_PUBLIC_: the key would ship to every visitor.
# Set ALL of these in Vercel for Production, Preview AND Development.
#
# After changing them locally, RESTART `next dev`. A running server keeps the
# environment it booted with, so a freshly pasted key is invisible until the
# process restarts — which looks exactly like a provider HTTP 401.
#
# Groq (current provider) — https://console.groq.com/keys
#   AI_MODERATION_API_KEY=gsk_your-server-side-key
#   AI_MODERATION_BASE_URL=https://api.groq.com/openai/v1
#   AI_MODERATION_TEXT_MODEL=openai/gpt-oss-120b
#   AI_MODERATION_VISION_MODEL=qwen/qwen3.8-27b
#
# Leave them unset and moderation degrades to "unscanned".
#
# The moderation verdict writer RPCs are ALSO secret-gated. Set a server-only worker secret
# and make it match the database row — a fresh database seeds that row with a
# NULL secret, so an unset row makes every moderation verdict fail with 42501
# ("Worker access required"):
#
#   MODERATION_WORKER_SECRET=your-worker-secret
#
#   -- run once in the Supabase SQL Editor, with the same value:
#   update public.moderation_secrets set worker_secret = 'your-worker-secret' where id;

# -----------------------------------------------------------------------------
# Donations (optional) — Stripe Checkout
# -----------------------------------------------------------------------------
# Mettivo accepts donations through Stripe Checkout. The publishable key is
# safe in the browser; the secret key is NEVER client-visible
# (docs/CONSTITUTION.md Article 1.5).
#
# Get both keys from: Stripe dashboard -> Developers -> API keys
#
# Publishable key — embedded in the client bundle to initialise Stripe.js.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your-publishable-key
#
# Secret key — server-side only, used by /api/donate/checkout to create
# Checkout Sessions. Must NOT appear in src/, in .env.local committed, or in
# any prompt.
STRIPE_SECRET_KEY=sk_test_your-secret-key

# -----------------------------------------------------------------------------
# Admin payment webhook (optional) — server-side only
# -----------------------------------------------------------------------------
# Stripe signs the webhook body with this secret, and the same value
# authenticates the record_payment_event() RPC. It is NEVER client-visible.
#
# Get it from: Stripe dashboard -> Developers -> Webhooks -> your endpoint.
# Then store the SAME value in admin_settings with SQL. See
# docs/ADMIN_CONTROL_CENTER.md for the exact statement.
#
# STRIPE_WEBHOOK_SECRET=whsec_your-webhook-signing-secret

# Resend is already used for moderation email. Marketing campaigns are drafts
# only; do not wire them to this key without consent and unsubscribe handling.
# RESEND_API_KEY=re_your-server-side-key
# MODERATION_EMAIL_FROM="Mettivo Safety <safety@your-domain>"
